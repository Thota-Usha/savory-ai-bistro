# Savory AI Bistro Configuration
SECRET_KEY=savory-super-secret-jwt-key-2026-michelin-star
DATABASE_URL=sqlite:///restaurant.db

# Optional: Add your Google Gemini API key to activate live Gemini 3.8 Flash models.
# If omitted, the built-in intelligent culinary heuristics engine operates seamlessly!
GEMINI_API_KEY=

# Firebase Cloud Integration
# 1. Option A: Place your downloaded service account key as 'backend/firebase-credentials.json'
# 2. Option B: Set FIREBASE_CREDENTIALS_PATH to your service account json file path
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=savory-ai-bistro
FIREBASE_SYNC_ENABLED=true
